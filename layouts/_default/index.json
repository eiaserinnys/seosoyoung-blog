{{- /* Source: PaperMod (MIT), layouts/_default/index.json. */ -}}
{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (in (slice "posts" "digest" "gallery" "lab") .Section) (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $title := .Title -}}
    {{- if and (eq .Section "gallery") (not $title) -}}
      {{- $title = .Params.cover.alt | default (printf "그림 %s" (.Date.Format "2006.01.02")) -}}
    {{- end -}}
    {{- $content := .Plain -}}
    {{- $permalink := .Permalink -}}
    {{- $summary := .Summary -}}
    {{- $kind := .Params.kind | default "" -}}
    {{- if eq .Section "lab" -}}
      {{- $content = .Params.summary | default "" -}}
      {{- $summary = .Params.summary | default "" -}}
      {{- $permalink = .Params.url | default "" -}}
      {{- if strings.HasPrefix $permalink "/" -}}
        {{- $permalink = $permalink | absURL -}}
      {{- end -}}
    {{- end -}}
    {{- $category := "" -}}
    {{- with .Params.categories -}}
      {{- $category = index . 0 -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "title" $title "content" $content "permalink" $permalink "summary" $summary "section" .Section "date" (.Date.Format "2006.01.02") "category" $category "kind" $kind) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
